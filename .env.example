# ==========================================================
# MangaVerse — Backend Environment Configuration (.env)
# ==========================================================

APP_NAME="MangaVerse — AI Manga Discover"
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False

# Comma-separated web origins allowed to call the API.
# In development: http://localhost:5173,http://127.0.0.1:5173
# In production on Vercel: https://your-mangaverse.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-mangaverse.vercel.app

# ==========================================================
# API Client & Rate Limiting
# ==========================================================

API_TIMEOUT=30
API_RETRIES=3
USER_AGENT=MangaVerse/1.0.0

# ==========================================================
# Logging
# ==========================================================

LOG_LEVEL=INFO

# ==========================================================
# Database (SQLite default or PostgreSQL / Supabase)
# ==========================================================
# Default local SQLite:
DATABASE_URL=sqlite:///database/app.db
# Or PostgreSQL (e.g. Supabase / Render Postgres):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ==========================================================
# Authentication / JWT
# ==========================================================

# Generate a strong 256-bit random key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# ==========================================================
# Gemini AI Assistant (Optional)
# ==========================================================

GEMINI_API_KEY=
